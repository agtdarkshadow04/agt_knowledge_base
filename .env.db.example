# Password of the database superuser (postgres), for Docker Compose (.env.db).
# Copy to .env.db. Only the db container reads it: the app connects as the
# non-superuser agt_knowledge_base role and never receives this password.
# You need it only for maintenance: docker compose exec db psql -U postgres
# Never commit .env.db; it is never included in backups.
POSTGRES_PASSWORD=
