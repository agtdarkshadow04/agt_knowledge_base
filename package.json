{
  "name": "agt-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:dev": "node --import tsx --watch backend/local-server.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "cdk:synth": "cdk synth --app 'node --import tsx infrastructure/app.ts'",
    "cdk:deploy": "cdk deploy --app 'node --import tsx infrastructure/app.ts'"
  },
  "dependencies": {
    "@aws-amplify/auth": "^6.15.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.890.0",
    "@aws-sdk/client-secrets-manager": "^3.890.0",
    "@mdxeditor/editor": "^4.3.0",
    "aws-amplify": "^6.15.0",
    "aws-jwt-verify": "^5.1.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.544.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
