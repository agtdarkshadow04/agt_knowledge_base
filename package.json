{
  "name": "agt-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node dist-server/index.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node26 --format=esm --packages=external --loader:.sql=text --outfile=dist-server/index.mjs",
    "build:scripts": "esbuild scripts/migrate.ts scripts/manage-local-user.ts --bundle --platform=node --target=node26 --format=esm --packages=external --outdir=dist-server/scripts --out-extension:.js=.mjs",
    "start": "node dist-server/index.mjs",
    "lint": "tsc -b --pretty false",
    "test": "npm run test:client && npm run test:server && npm run test:components",
    "test:client": "esbuild src/lib/*.test.ts --bundle --platform=node --target=node26 --format=esm --packages=external --outdir=.test-build/client --out-extension:.js=.mjs && node --test .test-build/client/*.test.mjs",
    "test:server": "esbuild server/test/*.test.ts --bundle --platform=node --target=node26 --format=esm --packages=external --loader:.sql=text --outdir=.test-build/server --out-extension:.js=.mjs && node --test --test-concurrency=1 .test-build/server/*.test.mjs",
    "test:components": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "db:migrate": "npm run build:scripts && node dist-server/scripts/migrate.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@mdxeditor/editor": "^4.3.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.544.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js": false
  }
}
