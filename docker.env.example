# AGT Knowledge Base secrets and bootstrap values for Docker Compose (.env).
# Copy to .env. Never commit .env; it is never included in backups.

# Temporary setup password, used ONLY on first run to create the single Admin
# account at /admin. It does not become the Admin password.
# After creating the Admin account, REMOVE this line and restart
# (docker compose up -d). While it is still set, the server logs a warning at
# every start.
AGT_KNOWLEDGE_BASE_SETUP_PASSWORD=replace-with-a-long-random-one-time-password

# The bundled PostgreSQL container. The API connects as POSTGRES_USER with
# POSTGRES_PASSWORD (passed to it as AGT_KNOWLEDGE_BASE_DB_PASSWORD).
# Replace the password before the first start.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=agt_knowledge_base
POSTGRES_USER=agt
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Host listener of the web container: loopback only, because the stack speaks
# plain HTTP. Put a TLS proxy in front (README, HTTPS) before opening it up.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
