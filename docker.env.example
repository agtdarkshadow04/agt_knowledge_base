# Public listener configuration.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
APP_ORIGIN=http://localhost:8080

# PostgreSQL configuration. Replace this password before starting the stack.
POSTGRES_DB=agt_knowledge_base
POSTGRES_USER=agt
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Local authentication. Generate a secret with: openssl rand -hex 32
LOCAL_AUTH_SECRET=replace-with-at-least-32-random-characters
LOCAL_AUTH_SESSION_HOURS=12
