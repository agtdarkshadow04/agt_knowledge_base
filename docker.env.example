# Public listener configuration.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
APP_ORIGIN=http://localhost:8080

# PostgreSQL configuration. Replace this password before starting the stack.
POSTGRES_DB=agt_knowledge_base
POSTGRES_USER=agt
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Existing Amazon Cognito user pool and web client identifiers.
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_USER_POOL_CLIENT_ID=exampleclientid
VITE_AWS_REGION=us-east-1
