# Public frontend configuration. These values are identifiers, not secrets.
VITE_API_URL=http://localhost:3001
VITE_AUTH_MODE=local

# API local development only. Never commit real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agt_knowledge_base
DATABASE_SSL=false
# Generate a secret with: openssl rand -hex 32
LOCAL_AUTH_SECRET=local-development-only-secret-32-chars
