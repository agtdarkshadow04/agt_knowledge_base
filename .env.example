# Public frontend configuration. These values are identifiers, not secrets.
# The Vite dev server proxies /api to the API on port 3001 (see vite.config.ts).
VITE_API_URL=/api

# API local development only. Never commit real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agt_knowledge_base
DATABASE_SSL=false
# Generate a secret with: openssl rand -hex 32
LOCAL_AUTH_SECRET=local-development-only-secret-32-chars
# Configuration file for the API (non-secret settings); a missing file means defaults.
CONFIG_FILE=./config.yaml
# One-time password for creating the Admin at /admin. Remove after setup.
AGT_SETUP_PASSWORD=local-development-setup-password
