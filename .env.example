# AGT Knowledge Base secrets and bootstrap values for local development (.env.local).
# Copy to .env.local. Never commit it; it is never included in backups.
# Non-secret settings (database host, name and user, port, ...) go in config.yaml.

# Temporary setup password, used ONLY on first run to create the single Admin
# account at /admin. It does not become the Admin password.
# After creating the Admin account, REMOVE this line and restart the server.
# While it is still set, the server logs a warning at every start.
AGT_KNOWLEDGE_BASE_SETUP_PASSWORD=local-development-setup-password

# Password of the database role (database.user in config.yaml, default
# agt_knowledge_base).
AGT_KNOWLEDGE_BASE_DB_PASSWORD=local-development-db-password

# Signs member sign-in tokens; at least 32 characters. Generate one with:
# openssl rand -hex 32
LOCAL_AUTH_SECRET=local-development-only-secret-32-chars
