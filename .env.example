# AGT Knowledge Base secrets and bootstrap values (.env)
# Copy to .env. Never commit .env; it is never included in backups.
# Non-secret settings (database host, name and user, port, ...) go in config.yaml.

# Temporary setup password, used ONLY on first run to create the single admin
# account at /admin. It does not become the admin password.
# After creating the admin account, REMOVE this line and restart
# (docker compose up -d, or sudo systemctl restart agt-knowledge-base).
# While it is still set, the server logs a warning at every start.
AGT_KNOWLEDGE_BASE_SETUP_PASSWORD=

# Password of the agt_knowledge_base database role (database.user in
# config.yaml). Docker Compose also gives it to the db service, which creates
# the role with it on first start. Generate one with: openssl rand -hex 24
AGT_KNOWLEDGE_BASE_DB_PASSWORD=

# Optional: this app's API access key in AGT IAM, for members' AGT sign-in
# (iam.* in config.yaml, switched on with the iam.enabled dashboard setting).
# Sent only to iam.baseUrl; never logged, shown or included in backups.
AGT_KNOWLEDGE_BASE_IAM_API_KEY=
